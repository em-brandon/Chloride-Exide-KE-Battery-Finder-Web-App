# Copy this file to .env (repo root) and fill in real values. Never commit .env.

# PostgreSQL connection string used by backend/db.py.
# Matches the docker-compose.yml Postgres service by default.
DATABASE_URL=postgresql://batteryfinder:batteryfinder@localhost:5432/batteryfinderdev

# Admin session cookie Secure flag — false for local HTTP dev, true in production (HTTPS).
ADMIN_COOKIE_SECURE=false

# Required by pipelines/web_battery_validate.py (AI-powered web search for battery validation).
TAVILY_API_KEY=
