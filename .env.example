# Copy this file to .env (repo root) and fill in real values. Never commit .env.

# PostgreSQL connection string used by backend/db.py.
# Matches the docker-compose.yml Postgres service by default (docker compose up -d).
# Published on 5434, not 5432 — see docker-compose.yml for why.
DATABASE_URL=postgresql://batteryfinder:batteryfinder@127.0.0.1:5434/batteryfinderdev

# Admin session cookie Secure flag — false for local HTTP dev, true in production (HTTPS).
ADMIN_COOKIE_SECURE=false

# --- pipelines/web_battery_validate.py (all optional — any source without a
# key/URL configured is simply skipped; queried in order SearXNG -> DuckDuckGo
# (no key needed) -> Brave -> Tavily) ---
SEARXNG_URL=
BRAVE_SEARCH_API_KEY=
BRAVE_MONTHLY_QUOTA=2000
TAVILY_API_KEY=
TAVILY_MONTHLY_QUOTA=1000
